# Normalize text files to LF in the repo (avoids LF/CRLF warnings on Windows).
* text=auto eol=lf

# Explicit text types
*.java text eol=lf
*.kt text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.dockerignore text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.jar binary
*.zip binary
