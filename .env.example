# AI English Hub — local development defaults (override in .env)
POSTGRES_USER=englishhub
POSTGRES_PASSWORD=englishhub
POSTGRES_DB=englishhub

JWT_SECRET=dev-only-change-me-to-a-long-random-secret-key-32b+
JWT_ISSUER=ai-english-hub
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
OLLAMA_QUIZ_MODEL=llama3.2:1b
OLLAMA_TUTOR_MODEL=llama3.2:1b
# Vision (image→text). Pull manually when needed: docker compose exec ollama ollama pull llava
OLLAMA_VISION_MODEL=llava
# Optional local image-gen model for multimodal /v1/image (flux / stable-diffusion).
# Leave empty to use offline educational SVG cards for tutor text→image.
# OLLAMA_IMAGE_MODEL=
# Optional server STT model (prefer browser Web Speech for <1s). Leave empty for stub.
# OLLAMA_STT_MODEL=
VISION_TIMEOUT=45
STT_TIMEOUT=8
TUTOR_OLLAMA_TIMEOUT=8
TUTOR_RAG_TIMEOUT=2.0
TUTOR_STT_TIMEOUT=8
TUTOR_VISION_TIMEOUT=35
QUIZ_PREFER_HEURISTIC=true
QUIZ_OLLAMA_TIMEOUT=0.8

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
